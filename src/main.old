const MOVE_SPEED: f32 = 0.1;
const LOOK_SPEED: f32 = 0.1;

#[repr(C)]
struct PointVertex {
    pos: Vec3,
    color: Color,
}

// 1. Define the Vertex and Fragment shaders
const VERTEX_SHADER: &str = "#version 100
    attribute vec3 pos;
    attribute vec4 color;
    varying lowp vec4 vColor;
    uniform mat4 Model;
    uniform mat4 Projection;

    void main() {
        gl_Position = Projection * Model * vec4(pos, 1.0);
        gl_PointSize = 2.0; // Fixed size for performance
        vColor = color;
    }
";

const FRAGMENT_SHADER: &str = "#version 100
    varying lowp vec4 vColor;
    void main() {
        gl_FragColor = vColor;
    }
";

mod display_shader {
    use miniquad::*;

    pub const VERTEX: &str = r#"#version 100
    attribute vec4 in_pos;
    attribute vec4 in_color;
    attribute vec2 in_uv;

    varying lowp vec4 color;
    varying lowp vec2 uv;

    uniform mat4 mvp;

    void main() {
        gl_Position = vec4(in_pos.x * 2., in_pos.z * 2., 0.0, 1.0);
        color = in_color;
        uv = in_uv;
    }
    "#;

    pub const FRAGMENT: &str = r#"#version 100
    varying lowp vec4 color;
    varying lowp vec2 uv;

    uniform sampler2D tex;

    void main() {
        gl_FragColor = color * texture2D(tex, uv);
    }
    "#;

    pub const METAL: &str = r#"#include <metal_stdlib>
    using namespace metal;

    struct Uniforms
    {
        float4x4 mvp;
    };

    struct Vertex
    {
        float3 in_pos      [[attribute(0)]];
        float4 in_color    [[attribute(1)]];
        float2 in_uv       [[attribute(2)]];
    };

    struct RasterizerData
    {
        float4 position [[position]];
        float4 color [[user(locn0)]];
        float2 uv [[user(locn1)]];
    };

    vertex RasterizerData vertexShader(Vertex v [[stage_in]], constant Uniforms& uniforms [[buffer(0)]])
    {
        RasterizerData out;

        out.position = uniforms.mvp * float4(v.in_pos, 1.0);
        out.color = v.in_color;
        out.uv = v.in_uv;

        return out;
    }

    fragment float4 fragmentShader(RasterizerData in [[stage_in]], texture2d<float> tex [[texture(0)]], sampler texSmplr [[sampler(0)]])
    {
        return in.color * tex.sample(texSmplr, in.uv);
    }"#;

    pub fn meta() -> ShaderMeta {
        ShaderMeta {
            images: vec!["tex".to_string()],
            uniforms: UniformBlockLayout {
                uniforms: vec![UniformDesc::new("mvp", UniformType::Mat4)],
            },
        }
    }

    #[repr(C)]
    pub struct Uniforms {
        pub mvp: glam::Mat4,
    }
}

fn window_conf() -> Conf {
    Conf {
        window_title: "HaiViz ".to_owned() +env!("CARGO_PKG_VERSION"),
        window_width: 1920,
        window_height: 1080,
        fullscreen: false,
        ..Default::default()
    }
}

fn draw_cloud(cloud: &Pointcloud) {
    // Build a Mesh of points (as degenerate triangles) for much faster rendering than many spheres.
    // We create a vertex per point and use a simple index list. To avoid exceeding u16 indices,
    // sample the cloud if it is extremely large.
    let max_vertices: usize = 60000; // keep under u16::MAX
    let len = cloud.points.len();
    let step = if len == 0 { 1 } else { (len + max_vertices - 1) / max_vertices };

    let mut vertices: Vec<Vertex> = Vec::with_capacity((len + step - 1) / step);
    let mut indices: Vec<u16> = Vec::with_capacity((len + step - 1) / step);

    let mut i = 0usize;
    while i < len {
        let p = &cloud.points[i];
        let pos = vec3(
            (p.x - cloud.min.x) as f32,
            (p.z - cloud.min.z) as f32,
            (p.y - cloud.min.y) as f32,
        );
        vertices.push(Vertex {
            position: pos,
            uv: vec2(0.0, 0.0),
            normal: vec4(0.0, 0.0, 0.0, 0.0),
            color: [0, 0, 255, 255],
        });
        indices.push((vertices.len() - 1) as u16);
        i += step;
    }

    if vertices.is_empty() {
        return;
    }

    // Construct Mesh directly
    let mesh = Mesh { vertices, indices, texture: None };

    // Draw mesh in 3D. Vertices already in world space.
    draw_mesh(&mesh);
}

fn draw_cloud_screen(cloud: &Pointcloud, cam_pos: Vec3, front: Vec3, right: Vec3, up: Vec3) {
    let max_points: usize = 60000;
    let len = cloud.points.len();
    if len == 0 {
        return;
    }
    let step = (len + max_points - 1) / max_points;

    // approximate vertical fov used by macroquad Camera3D (default ~60deg)
    let fov_y: f32 = std::f32::consts::FRAC_PI_3; // 60 degrees
    let aspect = screen_width() / screen_height();
    let f = 1.0 / (fov_y * 0.5).tan();

    let mut i = 0usize;
    while i < len {
        let p = &cloud.points[i];
        let world = vec3(
            (p.x - cloud.min.x) as f32,
            (p.z - cloud.min.z) as f32,
            (p.y - cloud.min.y) as f32,
        );

        let to_point = world - cam_pos;
        let cx = to_point.dot(right);
        let cy = to_point.dot(up);
        let cz = to_point.dot(front);

        if cz > 0.0 {
            let ndc_x = (cx * f / aspect) / cz;
            let ndc_y = (cy * f) / cz;
            let sx = (ndc_x * 0.5 + 0.5) * screen_width();
            let sy = (0.5 - ndc_y * 0.5) * screen_height();

            // size falls off with distance (clamped)
            let mut size = 4.0 * (1.0 / (cz * 0.1 + 1.0));
            if size < 1.0 { size = 1.0 }
            if size > 6.0 { size = 6.0 }

            draw_circle(sx, sy, size, BLUE);
        }

        i += step;
    }
}

async fn main_loop(cloud: &Pointcloud) {
    let mut ctx = unsafe { get_internal_gl().quad_context };

    let mut x = 0.0;
    let mut switch = false;
    let bounds = 8.0;

    let world_up = vec3(0.0, 1.0, 0.0);
    let mut yaw: f32 = 1.18;
    let mut pitch: f32 = 0.0;

    let mut front = vec3(
        yaw.cos() * pitch.cos(),
        pitch.sin(),
        yaw.sin() * pitch.cos(),
    )
    .normalize();
    let mut right = front.cross(world_up).normalize();
    let mut up = right.cross(front).normalize();

    let mut position = vec3(0.0, 1.0, 0.0);
    let mut last_mouse_position: Vec2 = mouse_position().into();

    let mut grabbed = false;
    set_cursor_grab(grabbed);
    show_mouse(!grabbed);

    let material = load_material(
        ShaderSource::Glsl { vertex: VERTEX_SHADER, fragment: FRAGMENT_SHADER },
        MaterialParams {
            pipeline_params: PipelineParams {
                primitive_type: PrimitiveType::Points, // Crucial for point clouds
                ..PipelineParams::default() 
            },
            ..Default::default()
        },
    ).unwrap();

    let mut vertices = Vec::with_capacity(cloud.points.len());
    let mut indices = Vec::with_capacity(cloud.points.len());

    for i in 0..cloud.points.len() {
        vertices.push(PointVertex {
            pos: vec3((cloud.points[i].x - cloud.min.x) as f32, (cloud.points[i].y - cloud.min.y) as f32, (cloud.points[i].z - cloud.min.z) as f32),
            color: Color::new(0.,0.,1.,0.),
        });
        indices.push(i as u16); // Note: u16 limits you to 65k points per mesh
    } 

    let vertex_buffer = ctx.new_buffer(BufferType::VertexBuffer, BufferUsage::Immutable, BufferSource::slice(&vertices));

    // 3. Create GPU Index Buffer with u32 (32-bit indices allow billions of points)
    let indices: Vec<u32> = (0..cloud.points.len() as u32).collect();
    let index_buffer = ctx.new_buffer(BufferType::IndexBuffer, BufferUsage::Immutable, BufferSource::slice(&indices));

    let bindings = Bindings {
        vertex_buffers: vec![vertex_buffer],
        index_buffer,
        images: vec![],
    };

    // 4. Create Shader and Pipeline
    let source = match ctx.info().backend {
            Backend::OpenGl => ShaderSource::Glsl {
                vertex: display_shader::VERTEX,
                fragment: display_shader::FRAGMENT,
            },
            Backend::Metal => ShaderSource::Msl {
                program: display_shader::METAL,
            },
        };
    let shader = ctx.new_shader(source, display_shader::meta()).unwrap();

    let pipeline = ctx.new_pipeline( 
        &[BufferLayout::default()], 
        &[
            VertexAttribute::new("pos", VertexFormat::Float3),
            VertexAttribute::new("color", VertexFormat::Float4),
        ], 
        shader,
        PipelineParams { ..Default::default() }
    );   

    loop {
        let delta = get_frame_time();

        if is_key_pressed(KeyCode::Escape) {
            break;
        }
        if is_key_pressed(KeyCode::Tab) {
            grabbed = !grabbed;
            set_cursor_grab(grabbed);
            show_mouse(!grabbed);
        }

        if is_key_down(KeyCode::Up) || is_key_down(KeyCode::W) {
            position += front * MOVE_SPEED;
        }
        if is_key_down(KeyCode::Down) || is_key_down(KeyCode::S) {
            position -= front * MOVE_SPEED;
        }
        if is_key_down(KeyCode::Left)  || is_key_down(KeyCode::A) {
            position -= right * MOVE_SPEED;
        }
        if is_key_down(KeyCode::Right)  || is_key_down(KeyCode::D) {
            position += right * MOVE_SPEED;
        }

        let (_mouse_wheel_x, mouse_wheel_y) = mouse_wheel();
        if mouse_wheel_y.abs() > 0.001 {
            if mouse_wheel_y < 0.0 {
                position -= front * MOVE_SPEED;
                
            }
            else if mouse_wheel_y > 0.0 {
                position += front * MOVE_SPEED;
            }
        }

        let mouse_position: Vec2 = mouse_position().into();
        let mouse_delta = mouse_position - last_mouse_position;

        last_mouse_position = mouse_position;

        if grabbed || is_mouse_button_down(MouseButton::Right) {
            yaw += mouse_delta.x * delta * LOOK_SPEED;
            pitch += mouse_delta.y * delta * -LOOK_SPEED;

            pitch = if pitch > 1.5 { 1.5 } else { pitch };
            pitch = if pitch < -1.5 { -1.5 } else { pitch };

            front = vec3(
                yaw.cos() * pitch.cos(),
                pitch.sin(),
                yaw.sin() * pitch.cos(),
            )
            .normalize();

            right = front.cross(world_up).normalize();
            up = right.cross(front).normalize();

            x += if switch { 0.04 } else { -0.04 };
            if x >= bounds || x <= -bounds {
                switch = !switch;
            }
        }

        clear_background(LIGHTGRAY);

        // Going 3d!

        let mut camera = Camera3D {
            position,
            up,
            target: position + front,
            //projection: Projection::Orthographics,
            z_far: 100000.0,
            ..Default::default()
        };
        set_camera(&camera);
        /*set_camera(&Camera3D {
            position,
            up,
            target: position + front,
            //projection: Projection::Orthographics,
            z_far: 100000.0,
            ..Default::default()
        });*/

        //draw_grid(20, 1., BLACK, GRAY);

        // draw_cloud(cloud); // original mesh-based batch
        //draw_cloud_screen(cloud, position, front, right, up);
        //gl_use_material(&material);
        
        // Since indices are u16, for > 65k points, you'll need to 
        // split into multiple Meshes or use raw miniquad bindings.
        /*draw_mesh(&Mesh {
            vertices: vertices.clone(),
            indices: indices.clone(),
            texture: None,
        });*/
        
        let (view_mat, proj_mat) = (camera.viewport(),camera.projection);

        // Access the miniquad context again for drawing
        //let mut gl = get_internal_gl();
        let mut gl = unsafe { get_internal_gl() };
        //let ctx = &mut gl.quad_context;
        gl.flush(); // Clear macroquad's internal draw queue
        
        let ctx = &mut gl.quad_context;
        ctx.apply_pipeline(&pipeline);
        ctx.apply_bindings(&bindings);
        
        // Pass the matrices to the shader
        //ctx.apply_uniforms(&[view_mat, proj_mat]);
        
        // Draw the points!
        ctx.draw(0, cloud.points.len() as i32, 1);        
        
        //gl_use_default_material();
        /*draw_line_3d(
            vec3(x, 0.0, x),
            vec3(5.0, 5.0, 5.0),
            Color::new(1.0, 1.0, 0.0, 1.0),
        );*/

        draw_cube_wires(vec3(0., 1., -6.), vec3(2., 2., 2.), GREEN);
        draw_cube_wires(vec3(0., 1., 6.), vec3(2., 2., 2.), BLUE);
        draw_cube_wires(vec3(16., 13., 8.), vec3(2., 2., 2.), RED);



        // Back to screen space, render some text

        set_default_camera();
        draw_text("First Person Camera", 10.0, 20.0, 30.0, BLACK);

        draw_text(
            format!("X: {} Y: {}", mouse_position.x, mouse_position.y).as_str(),
            10.0,
            48.0 + 18.0,
            30.0,
            BLACK,
        );
        draw_text(
            format!("Press <TAB> to toggle mouse grab: {grabbed}").as_str(),
            10.0,
            48.0 + 42.0,
            30.0,
            BLACK,
        );
        next_frame().await
    }

}

#[macroquad::main(window_conf)]
async fn main() {
    if env::args().count() != 2    {
        println!("{}",style("Usage: haiviz pointcloud.laz").red());
        return;
    }
    let args: Vec<String> = env::args().collect();
    let cloudfile = &args[1];

    let mut cloud = Pointcloud::new();
    println!("Loading {}",cloudfile);
    cloud.load(cloudfile.to_owned(),true,None);
    println!("Starting loop");
    main_loop(&cloud).await
}
